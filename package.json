{
  "name": "equation-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Type math like Desmos, get a standalone function in Go, Python, Rust, TypeScript or Java.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "pnpm build && node server.ts",
    "dev": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch server.ts)",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.1.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
