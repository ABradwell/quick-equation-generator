{
  "name": "equation-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Type math like Desmos, get a standalone function in Go, Python, Rust, TypeScript or Java.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "10.1.0",
    "prettier": "3.8.1"
  }
}
